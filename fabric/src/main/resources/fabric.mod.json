{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {},
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.github.magishanpixel.mgn_witch_hat.MGNWitchHat_FABRIC"
        ],
        "client": [
            "io.github.magishanpixel.mgn_witch_hat.client.MGNWitchHatClient_FABRIC"
        ],
        "fabric-datagen": [
            "io.github.magishanpixel.mgn_witch_hat.datagen.MGNWitchHatDataGen"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}",
        "balm-fabric": ">=${balm_version_min}"
    }
}
  